<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="../css/bootstrap.min.css" rel="stylesheet" >
    <link rel="stylesheet" href="../css/table.css">
    <link rel="stylesheet" href="../css/modall.css">
    <link rel="stylesheet" href="../css/main.css">
    <title>Inicio</title>
</head>
<body>
    <%-include ("./header")%>

    <div class="card_emergent_alert"></div>

    <div class="modalBoxLog home" id="modalBoxLog" style="display: none; z-index: 1000;">
        <div class="card" style="width: 400px; margin: auto; ">
            <div class="modal-header">
                <p>Codigo del cajero/a</p>
                <button type="button" class="btn close_modal">
                    <span class="material-symbols-outlined close_modal">close</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-danger" id="error_code"></p>
                <form action="">
                    <div class="input-groupe">
                        <button type="button" id="logoutCasheir" disabled class="btn btn-danger form-control mb-3">Desconectar</button>
                        <select class="form-select mb-3" name="" id="listCashiers">
                            <!-- <option value="no_data">Cajero/a</option> -->
                        </select>
                        <input type="text" name="" class="form-control" id="code" placeholder="Introduce tu codigo">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="codeToLog" >Entrar</button>
            </div>
        </div>
    </div>

    <div class="modal fade" id="exampleModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Conectar Caja</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="">
                        <button type="button" id="btn_dsconnect_checkout" disabled class="btn btn-danger form-control mb-3">Desconectar caja</button>
                        <select class="form-select me-2" id="checkouts">
                            <!-- <option value="no_data">Caja#</option> -->
                        </select>
                    </form>
                </div>
                <div class="modal-footer">
                    <!-- <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button> -->
                    <button type="button" id="btn_connect_checkout" class="btn btn-primary">Conectar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="box_store_name">
        <div class="card_store_name">
            <form class="card">
                <div class="card-header">
                    <p class="tx_ist">Nombre y tipo de tu negocio</p>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <input type="text" class="form-control" id="p_store_name" placeholder="Nombre de tu negocio">
                    </div>
                    <div class="input-group">
                        <select class="form-select" id="type_b" style="width: 100%;">
                            <option value="">Tipo de negocio</option>
                            <option value="supermercado">Supermercado</option>
                            <option value="servicio">Servicio</option>
                            <option value="hipermercado">Hipermercado</option>
                            <option value="mini market">Mini market</option>
                            <option value="sarmacia">Farmacia</option>
                            <option value="restaurante">Restaurante</option>
                            <option value="cafeteria">Cafeteria</option>
                            <option value="tienda">Tienda</option>
                            <option value="colmado">Colmado</option>
                            <option value="estileria">Estileria</option>
                            <option value="almacen">Almacen</option>
                            <option value="ferreteria">Ferreteria</option>
                            <option value="tienda de electrodomesticos">Tienda de electrodomesticos</option>
                        </select>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" id="btn_store_name">Enviar</button>
                </div>
            </form>
        </div>
    </div>

        <!-- Modal -->
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal_dialog ">
            <div class="modal-content modal_content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Nueva Venta/Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="" id="msg_err"></div>
                    <div class="border-bottom  row_one">
                        <div class="user me-3 d-flex align-items-center">
                            <div class="d-flex">
                                <p class="me-2 mb-0" style="font-weight: 500;">Cajera: </p>
                                <!-- <p class="mb-0 " style="font-weight: 500;" id="c_user"></p> -->
                                <input type="text" id="c_user" class="form-control" disabled>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="d-flex">
                                <p class="me-2 mb-0" style="font-weight: 500;">Caja: </p>
                                <!-- <p class="mb-0 " style="font-weight: 500;" id="caja"></p> -->
                                <input type="text" id="num_checkout" class="form-control" style="width: 60px;" disabled>
                            </div>
                        </div>
                        <div>
                            <div class="d-flex align-items-center">
                                <label for="" class="me-2">Cliente:</label>
                                <!-- <p class="client_name m-0"></p> -->
                                <input type="text" class="form-control client_name" id="clientSearch" autocomplete="off" placeholder="Buscar clientes">
                                <span class="material-symbols-outlined delete_client text-danger ms-2" style="display: none;">close</span>
                            </div>
                            <div class="position-relative">
                                <div class="boxSearchClients boxSearchElements">
                                    <table class="tableSearch">
                                        <thead>
                                            <tr>
                                                <th>code</th>
                                                <th>nombre</th>
                                                <th>accion</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cardSearchClients"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="date"></div>
                        </div>
                    </div>
                    <div class="mb-2 card_inset">
                        <div class="d-flex" style="width: 500px;">
                            <select id="mode_code" style="width: 120px;" >
                                <option value="automatico">Automatico</option>
                                <option value="manual">Manual</option>
                            </select>
                            <input type="number" class="form_control input_code" placeholder="Ingresa el codigo del producto aqui" id="codigo">
                            <button type="button" id="add" style="display:none;" class="btn btn-primary ms-3">Agregar</button>
                        </div>
                        <div class="" style="width: 250px;">
                            <div class="d-flex align-items-center">
                                <input type="text" class="form_control textSearch" id="textSearch" placeholder="Buscar productos (nombre o codigo)">
                            </div>
                            <div class="position-relative">
                                <div class="boxSearchProducts boxSearchElements">
                                    <table class="tableSearch">
                                        <thead>
                                            <tr>
                                                <th>code</th>
                                                <th>descripcion</th>
                                                <th>precio</th>
                                                <th>accion</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cardSearchProducts"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between" style="width: 180px;">
                            <a href="" class="btn btn-warning " id="clean_list">Limpiar</a>
                            <a href="" id="factura" class="btn btn-primary inactive" >Factura</a>
                        </div>
                    </div>
                    <div class="w-100" id="list_product">
                        <table class="table_xzs">
                            <thead class="thead_products" id="thead">
                                <tr>
                                    <th scope="col">Unidad</th>
                                    <th scope="col">Descripcion</th>
                                    <th scope="col">Precio</th>
                                    <% if(user.system_control.sale_with_ITBIS){%>
                                        <th scope="col">ITBIS</th>
                                    <%}%>
                                    <th scope="col">Accion</th>
                                </tr>
                            </thead>
                            <tbody id="showListProduct"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="content_footer">
                        <div class="footer_data">
                            <div>
                                <div class="mr-5 d-flex">
                                    <p class="fs-5" style="font-weight: 500; margin: 0; width: 120px;">Subtotal: </p>
                                    <p class="fs-5" style="width: 130px; font-weight: 500; margin: 0 10px 0 10px;" id="subTotal">0.00</p>
                                </div>
                                <div class="mr-5 itbis_Card" style="display: none;">
                                    <p class="fs-5" style="font-weight: 500; margin: 0; width: 120px;">ITBIS: </p>
                                    <p class="fs-5" style="width: 115px; font-weight: 500; margin: 0 10px 0 10px;" id="itbis">0.00</p>
                                </div>
                                <div class="mr-5 d-flex">
                                    <p class="fs-2" style="font-weight: 1000; margin: 0; width: 120px;">Total: </p>
                                    <p class="fs-2" style="width: 150px; font-weight: 1000; margin: 0 10px 0 10px;" id="total">0.00</p>
                                </div>
                            </div>
    
                            <div>
                                <div class="d-flex align-items-center">
                                    <label for="pago" class="col-form-label fs-5" style="font-weight: 500;  width: 110px;">Pago:</label>
                                    <input type="number" class="form-control ml-3" style="width: 130px;" id="pago">
                                </div>
                                <div class="">
                                    <div class="mr-5 d-flex">
                                        <p class="fs-5" style="font-weight: 500; margin: 0;  width: 110px;">Cambio: </p>
                                        <p class="fs-5" style="width: 115px; font-weight: 500; margin: 0;" id="cambio">0.00</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="footer_btn row pb-2">
                            <div class="row g-2">
                                <button type="button" class="col-sm btn btn-success btn-lg" style="margin: 0px" id="finich" >Finalizar venta</button>
                            </div>
                            <div class="row g-2 gap-3 " >
                                <button type="button" class="col-sm btn btn-danger" id="cancel" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="col-sm btn btn-primary" id="cerrar" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="my_container" id="container">
        <div class="main_container">
            <div class="card_container bg_color_white">
                <div class="the_title">
                    <h5 class="mb-1">Punto de venta</h5>
                </div>
                <div class="box_table">
                    <div class="mbg">
                        <div class="head_mbg">
                            <div class="d-flex ">
                                <div class="input-group me-3" >
                                    <button class="btn btn-outline-success" type="button" id="button-addon1"  data-bs-toggle="modal" data-bs-target="#exampleModal">
                                        Elegir
                                    </button>
                                    <input type="text" class="form-control" placeholder="Caja#" id="showCheckout" disabled>
                                </div>
                                
                                <div class="input-group me-2" >
                                    <button class="btn btn-outline-success" type="button" id="btn_open_card_casheir" disabled >
                                        Elegir
                                    </button>
                                    <input type="text" class="form-control" placeholder="Cajera" id="showCashier" disabled>
                                </div>

                                <!-- <select class="form-select" name="" id="">
                                    <option value="no_data">Cajero/a</option>
                                </select> -->
                            </div>
            
                            <div>
                                <button type="button" id="btn_open_sele" class="btn_atla" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                                    <span class="material-symbols-outlined">add</span>
                                    Nueva venta
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card_table_body">
                        <table class="tbs tableShowData">
                            <thead class="thead">
                                <tr>
                                    <th scope="col">Codigo</th>
                                    <th scope="col">Productos</th>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">Accion</th>
                                </tr>
                            </thead>
                            <tbody id="tbody"></tbody> 
                        </table>
                    </div>
                    <div class="card_table_fooder">
                        <p class="mb-0" id="countSales"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="../js/bootstrap.bundle.min.js" ></script>
    <script type="module" src="../js/app.js"></script>
</body>
</html>